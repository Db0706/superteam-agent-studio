# Copy to .env.local and fill in. Never commit real values. See docs/ENVIRONMENT.md.

# Supabase (app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Postgres (app and worker). On Vercel: the transaction pooler (port 6543) and DATABASE_POOL_SIZE=3.
DATABASE_URL=
DATABASE_POOL_SIZE=

# Verification engine secrets (app and worker). Generate each with: openssl rand -base64 32
CHALLENGE_BASE_URL=http://localhost:3100
RECEIPT_SIGNING_KEY=
VERIFIER_SEED_SECRET=
FIXTURE_SECRET=

# Optional
ACTIVE_EVENT_SLUG=oxbridge-ai-race-2026
FIXTURES_ENABLED=true
WORKER_CONCURRENCY=8

# Local development and tests only
VERIFIER_ALLOW_PRIVATE_TARGETS=true
SUPABASE_SERVICE_ROLE_KEY=

# Judging in Google Sheets (docs/GOOGLE_SHEETS.md). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
