{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'Verification worker: no build step (runs TypeScript with tsx)'",
    "watchPatterns": ["worker/**", "src/core/**", "src/server/**", "package.json", "package-lock.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "npm run worker",
    "numReplicas": 2,
    "restartPolicyType": "ALWAYS"
  }
}
